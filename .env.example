# TODO(webapp-first): variables the Telegram Mini App work still needs —
#   INTERNAL_API_KEY            shared secret so only the bot can call POST /auth/telegram
#                               (docs/WEBAPP_FIRST_AUDIT.md §1.1 — currently unauthenticated)
#   INIT_DATA_MAX_AGE_SECONDS   replay window for Telegram initData (audit §1.2, 24h today)
#   AI_DAILY_LIMIT_PER_USER     per-user AI quota (TZ §32)
#   AI_VISION_DAILY_LIMIT       per-user food-photo quota (TZ §32)
# The STORAGE_* variables below are declared but not read by any code yet; they become live when
# camera uploads land (TZ §20).

DATABASE_URL=postgresql+asyncpg://gym:gym@postgres:5432/gym
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the frontend (e.g. an ngrok tunnel, or a real deployment) — required only to
# launch the bot's "Open App" button as a Telegram Mini App. Must be https://; leave empty and the
# bot falls back to its original text-command flow instead of showing a broken button. See
# docs/ARCHITECTURE.md §8 for how to get one for local testing (ngrok) vs. production.
FRONTEND_URL=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
