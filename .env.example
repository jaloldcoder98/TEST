DATABASE_URL=postgresql+asyncpg://gym:gym@postgres:5432/gym
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Set only while rotating the bot token at BotFather: both are accepted during the window, so a
# rotation doesn't sign every open Mini App out at once (docs/DECISIONS.md D-18). Clear it after.
TELEGRAM_BOT_TOKEN_PREVIOUS=
# Proves a /auth/telegram call really came from the bot (D-20). That endpoint trusts the
# telegram_id it is given, so without this anyone able to reach it could sign in as anyone. The
# backend refuses the endpoint entirely when this is unset, and the bot must use the same value.
# Generate one with: openssl rand -hex 32
BOT_SHARED_SECRET=
# Telegram ids promoted to super_admin at startup (D-32). Comma-separated. Promote-only: removing
# an id here never demotes anyone.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=
# Leave true everywhere real. The refresh cookie needs Secure for its __Host- prefix, SameSite=None
# and Partitioned (D-13); set false only for a plain-HTTP local run, which drops all three.
COOKIE_SECURE=true
# Development/staging only. Turns on SQL echo logging and mounts the Phase 0 Telegram WebView
# diagnostics at /api/v1/_diag/* (see docs/PHASE0_TEST_RUNBOOK.md). MUST be false in production —
# those routes are not mounted at all when it is.
DEBUG=true
# Public HTTPS URL of the frontend (e.g. an ngrok tunnel, or a real deployment) — required only to
# launch the bot's "Open App" button as a Telegram Mini App. Must be https://; leave empty and the
# bot falls back to its original text-command flow instead of showing a broken button. See
# docs/ARCHITECTURE.md §8 for how to get one for local testing (ngrok) vs. production.
FRONTEND_URL=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
