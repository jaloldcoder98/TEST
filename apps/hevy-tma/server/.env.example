# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
DATABASE_URL="postgresql://hevy:hevy@localhost:5432/hevy_tma?schema=public"

# --- Telegram ---
# From @BotFather. Used to verify the HMAC signature of initData.
TELEGRAM_BOT_TOKEN=123456:AA-your-bot-token
# How old initData may be, in seconds (Telegram recommends <= 24h).
TELEGRAM_INITDATA_MAX_AGE_SEC=86400
# Set to true ONLY for local development without Telegram: skips signature
# verification and authenticates as DEV_TELEGRAM_ID. Refused when NODE_ENV=production.
AUTH_DEV_BYPASS=false
DEV_TELEGRAM_ID=100000001

# --- CORS ---
# Comma-separated list of allowed origins (your Mini App URL).
CORS_ORIGINS=http://localhost:5173,https://your-mini-app.example.com

# --- Seed ---
# Path to the exercise dataset consumed by `npm run seed`.
EXERCISES_DATASET=../../../data/exercises/exercises.en.json
